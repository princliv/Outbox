# API Backend URLs
BASE_URL=https://outbox.nablean.com/api/v1
ADMIN_BASE_URL=https://obadmin.nablean.com/api/v1

# Local Development Alternatives (uncomment to use):
# BASE_URL=http://localhost:5000/api/v1
# BASE_URL=http://10.0.2.2:5000/api/v1
# ADMIN_BASE_URL=http://localhost:5000/api/v1
# ADMIN_BASE_URL=http://10.0.2.2:5000/api/v1

# Google / Firebase API Keys
GOOGLE_ANDROID_API_KEY=your_android_api_key_here
GOOGLE_IOS_API_KEY=your_ios_api_key_here
GOOGLE_WEB_API_KEY=your_web_api_key_here

# Firebase Project Credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PROJECT_NUMBER=your_firebase_project_number
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket
FIREBASE_AUTH_DOMAIN=your_auth_domain

# Firebase Web / Windows
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=your_web_app_id
FIREBASE_WEB_MEASUREMENT_ID=your_measurement_id
FIREBASE_WINDOWS_APP_ID=your_windows_app_id

# Firebase Android
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=your_android_app_id
FIREBASE_ANDROID_CLIENT_ID=your_android_client_id

# Firebase iOS / macOS
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_IOS_APP_ID=your_ios_app_id
FIREBASE_IOS_CLIENT_ID=your_ios_client_id
FIREBASE_IOS_REVERSED_CLIENT_ID=your_reversed_client_id
FIREBASE_IOS_BUNDLE_ID=your_ios_bundle_id
